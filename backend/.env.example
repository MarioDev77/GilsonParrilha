# ============================================================
# Gilson Parrilha — Backend
# Copie para .env e preencha. NUNCA commite o .env real.
# Todos os valores abaixo são fictícios.
# ============================================================

NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# PostgreSQL (obrigatório). Troque USUARIO, SENHA e HOST.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/gilson_parrilha?schema=public"

# Origens do frontend autorizadas no CORS (separe por vírgula, sem barra final).
# Em produção só são aceitas origens https.
FRONTEND_ORIGIN="http://localhost:3000"

# Segredo para assinar/derivar tokens de sessão (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="troque-por-um-segredo-aleatorio-com-no-minimo-32-caracteres"
SESSION_TTL_HOURS=12

# Cookie de sessão do painel admin.
# Local: lax. Produção com frontend (Vercel) e API (Railway) em domínios diferentes: none (exige HTTPS).
# Se usar domínio próprio com subdomínios (ex.: app.seusite.com + api.seusite.com): lax + COOKIE_DOMAIN=.seusite.com
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.seusite.com

# Quantidade de proxies confiáveis à frente da API (Railway = 1). Local = 0.
TRUST_PROXY=0

# --- Primeiro administrador (opcional: o comando `npm run admin:create` pergunta se não estiver aqui) ---
ADMIN_INITIAL_NAME="Administrador"
ADMIN_INITIAL_EMAIL="admin@exemplo.com"
# A senha é digitada (oculta) no comando de criação; nunca fica em arquivo.

# Número comercial do WhatsApp com DDI+DDD (ex.: 5575999999999). Usado pelo seed para criar as configurações.
WHATSAPP_NUMBER="5575900000000"

# --- Próximas etapas (ainda não usados) ---
# Armazenamento de imagens (local em dev; bucket S3-compatível em produção)
STORAGE_DRIVER=local
UPLOAD_MAX_MB=5
